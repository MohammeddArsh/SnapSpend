# =========================================================================
# SnapSpend Environment Variables
# Copy this file to `.env` and fill in your credentials.
# NEVER commit the real `.env` file to the repository.
# =========================================================================

# Supabase project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=

# Supabase anon (public) API key — Project Settings -> API
VITE_SUPABASE_ANON_KEY=

# Google Gemini API key — used by the receipt ParserEngine (app + eval)
# https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# OpenRouter API key — used by the evaluation module to benchmark many models
# https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=

# -------------------------------------------------------------------------
# Secrets for the AI Assistant edge function (set via `supabase secrets set`,
# NOT in this file):
#   supabase secrets set GEMINI_API_KEY=...
#   supabase secrets set SUPABASE_DB_URL=postgresql://postgres:...@db.your-project.supabase.co:5432/postgres
#   supabase functions deploy assistant
# -------------------------------------------------------------------------
