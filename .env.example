# --- Supabase Database Configuration ---
# Required for personal balance sheet authentication, ledger storage, and database features.
# Copy these values from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --- FastAPI Receipt OCR Backend Service ---
# Required if connecting to the Python FastAPI receipt parsing service.
VITE_OCR_API_URL=http://localhost:8000

# --- Google Gemini AI Key (Optional Backend Service Configuration) ---
# Used by the Python backend service for receipt parsing.
GEMINI_API_KEY=your-gemini-api-key-here


